{
    "name": "ssalkongpang-tooling",
    "private": true,
    "scripts": {
        "setup:gamekit": "node scripts/setup-gamekit.cjs",
        "generate:icons": "node scripts/generate-app-icons.cjs",
        "build": "node scripts/build-pages.cjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:build": "npm run setup:gamekit && node --test scripts/setup-gamekit.test.cjs scripts/build-pages.test.cjs scripts/netcode-qa-module.test.cjs scripts/vector-assets-loader-regression.cjs",
        "test:ui": "npm run setup:gamekit && node scripts/netcode-ui-e2e.cjs",
        "test:friend": "npm run setup:gamekit && node scripts/friend-match-e2e.cjs",
        "test:worker": "npm run setup:gamekit && node scripts/sim-worker-e2e.cjs",
        "test:startup": "npm run setup:gamekit && node scripts/vector-assets-startup-e2e.cjs",
        "test:economy": "npm run setup:gamekit && node scripts/capture-economy-e2e.cjs",
        "test:impact": "npm run setup:gamekit && node scripts/launch-impact-e2e.cjs"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "playwright": "1.63.0",
        "prettier": "3.9.10"
    }
}
